{
  "name": "1password-browser-mcp",
  "version": "0.1.0",
  "description": "Browser MCP server that signs in with 1Password: drives your real Chrome/Brave profile and fills logins via the 1Password extension or CLI",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "keywords": [
    "mcp",
    "browser",
    "chrome",
    "brave",
    "1password",
    "playwright",
    "cdp"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bin": {
    "1password-browser-mcp": "dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright-core": "^1.65.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/marekkirejczyk/1password-browser-mcp.git"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
